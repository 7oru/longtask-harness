{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Longtask task contract",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "domain", "objective", "successCriteria"],
  "properties": {
    "schemaVersion": { "type": "integer" },
    "id": { "type": "string" },
    "title": { "type": "string" },
    "domain": { "type": "string" },
    "objective": { "type": "string" },
    "successCriteria": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["id", "description"],
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" },
              "metric": {
                "type": "string",
                "enum": ["manual", "command", "output_contains", "llm_judge", "custom"]
              },
              "target": {},
              "weight": { "type": "number", "minimum": 0 }
            }
          }
        ]
      },
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["id", "description"],
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" },
              "type": {
                "type": "string",
                "enum": ["hard", "soft"]
              },
              "category": {
                "type": "string",
                "enum": ["time", "cost", "safety", "scope", "quality", "privacy", "other"]
              }
            }
          }
        ]
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "links": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "workerPolicy": {
      "type": "object",
      "properties": {
        "preferred": { "type": "string" },
        "allowed": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "rateLimitPolicy": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["openclaw-provider", "codex-cli", "scheduler", "external-api", "manual"]
          }
        },
        "fallbackWaitSeconds": { "type": "integer", "minimum": 0 },
        "allowHandoffOnRateLimit": { "type": "boolean" }
      }
    }
  }
}
