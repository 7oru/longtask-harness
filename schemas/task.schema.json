{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Longtask task contract",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "domain", "objective", "successCriteria"],
  "properties": {
    "schemaVersion": { "type": "integer" },
    "id": { "type": "string" },
    "title": { "type": "string" },
    "domain": { "type": "string" },
    "objective": { "type": "string" },
    "successCriteria": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "workerPolicy": { "type": "object" }
  }
}

