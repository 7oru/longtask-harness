{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Longtask checkpoint",
  "type": "object",
  "required": ["schemaVersion", "taskId", "status", "nextStep", "updatedAt"],
  "properties": {
    "schemaVersion": { "type": "integer" },
    "taskId": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["active", "paused", "blocked", "done", "needs-human"]
    },
    "currentPhase": { "type": "string" },
    "nextStep": { "type": "string" },
    "blockedUntil": {
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "blocker": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["rate_limit", "auth_error", "test_failure", "missing_context", "external", "manual", "unknown"]
            },
            "source": {
              "type": "string",
              "enum": ["openclaw-provider", "codex-cli", "kimi-cli", "scheduler", "external-api", "manual"]
            },
            "provider": { "type": "string" },
            "model": { "type": "string" },
            "message": { "type": "string" },
            "observedAt": { "type": "string" },
            "retryAfterSeconds": {
              "anyOf": [{ "type": "number" }, { "type": "null" }]
            },
            "requiresHuman": { "type": "boolean" }
          }
        }
      ]
    },
    "lastCompletedStep": { "type": "string" },
    "activeFiles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "openQuestions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "object" }
    },
    "workerCooldowns": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "source": { "type": "string" },
          "message": { "type": "string" },
          "observedAt": { "type": "string" },
          "blockedUntil": { "type": "string" },
          "retryAfterSeconds": {
            "anyOf": [{ "type": "number" }, { "type": "null" }]
          },
          "evidence": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      }
    },
    "updatedAt": { "type": "string" }
  }
}
