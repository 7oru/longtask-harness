    {
      "id": "no-dense-retries",
      "description": "Do not retry aggressively after rate limits.",
      "type": "hard",
      "category": "cost"
    }
  ],
  "context": {
    "summary": "Example coding task used to prove checkpointed resumability.",
    "files": [],
    "links": []
  },
